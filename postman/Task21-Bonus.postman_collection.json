{
  "info": {
    "name": "Task21 Bonus - Nested and Retry",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requires dev seed course1: capacity1, no enrolled students. Uses own fixtures and cleans up. Real concurrent conflict verification is recorded separately."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/test-demo/api"
    },
    {
      "key": "fullCourseId",
      "value": 1
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runTag')) pm.collectionVariables.set('runTag',pm.variables.replaceIn('{{$guid}}')); "
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Create Occupant",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/students",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Occupant\", \"surname\": \"Bonus-{{runTag}}\", \"age\": 20}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('occupant',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Candidate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/students",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Candidate\", \"surname\": \"Bonus-{{runTag}}\", \"age\": 20}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('candidate',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Rollback",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/students",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Rollback\", \"surname\": \"Bonus-{{runTag}}\", \"age\": 20}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('rollbackStudent',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Open course",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/courses",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Open-{{runTag}}\", \"credit\": 3, \"teacher\": \"Bonus\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('openCourse',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Rollback course",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/courses",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Rollback-{{runTag}}\", \"credit\": 3, \"teacher\": \"Bonus\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('rollbackCourse',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Fill the one-seat fixture",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/students/{{occupant}}/courses/{{fullCourseId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Bulk - skip full course",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/students/{{candidate}}/courses/bulk",
        "body": {
          "mode": "raw",
          "raw": "{\"courseIds\":[{{openCourse}},{{fullCourseId}}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test('Available course committed',()=>pm.expect(b.enrolledCourseIds).to.eql([Number(pm.collectionVariables.get('openCourse'))]));",
              "pm.test('Full course skipped',()=>pm.expect(b.fullCourseIds).to.eql([Number(pm.collectionVariables.get('fullCourseId'))]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read committed membership",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/students/{{candidate}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Only available membership',()=>pm.expect(pm.response.json().courses.map(c=>c.id)).to.eql([Number(pm.collectionVariables.get('openCourse'))]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Bulk - later error rolls back outer transaction",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/students/{{rollbackStudent}}/courses/bulk",
        "body": {
          "mode": "raw",
          "raw": "{\"courseIds\":[{{rollbackCourse}},9223372036854775807]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "No membership after outer rollback",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/students/{{rollbackStudent}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Successful nested work also rolled back',()=>pm.expect(pm.response.json().courses).to.eql([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Empty list rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/students/{{candidate}}/courses/bulk",
        "body": {
          "mode": "raw",
          "raw": "{\"courseIds\":[]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create salary fixture",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/employees",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Bonus\",\"surname\":\"Retry-{{runTag}}\",\"salary\":1000,\"departmentId\":1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('retryEmployee',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Retry-enabled salary operation",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/isolation/employees/{{retryEmployee}}/raise?amount=100&isolation=REPEATABLE_READ&delayMs=0&retry=true"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Salary updated',()=>pm.expect(pm.response.json().newSalary).to.eql(1100));"
            ]
          }
        }
      ]
    },
    {
      "name": "Retry isolation guard",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/isolation/employees/{{retryEmployee}}/raise?amount=100&isolation=READ_COMMITTED&delayMs=0&retry=true"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cleanup candidate",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/students/{{candidate}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204',()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cleanup occupant",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/students/{{occupant}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204',()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cleanup rollbackStudent",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/students/{{rollbackStudent}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204',()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cleanup retryEmployee",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/employees/{{retryEmployee}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204',()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cleanup openCourse",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/courses/{{openCourse}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204',()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cleanup rollbackCourse",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/courses/{{rollbackCourse}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204',()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}