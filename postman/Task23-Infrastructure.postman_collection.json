  "item": [
    {
      "name": "Locale az",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept-Language",
            "value": "az"
          }
        ],
        "url": "{{baseUrl}}/api/students/99999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status\", () => pm.response.to.have.status(404));",
              "pm.test(\"Error code\", () => pm.expect(pm.response.json().code).to.eql(\"ERR-2000\"));",
              "pm.test(\"Trace header equals body\", () => pm.expect(pm.response.json().traceId).to.eql(pm.response.headers.get(\"X-Trace-Id\")));",
              "pm.test(\"Error fields\", () => pm.expect(pm.response.json()).to.have.all.keys(\"status\", \"code\", \"message\", \"errors\", \"traceId\", \"timestamp\"));",
              "pm.test(\"Localized message\", () => pm.expect(pm.response.json().message).to.eql(\"Tələbə tapılmadı: 99999\"));"
            ]
          }
        }
      ]
    },
