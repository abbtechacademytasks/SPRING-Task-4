{
  "info": {
    "name": "Task21 Cache",
    "description": "Task20 endpoint-ləri və Task21 Cache yoxlamaları və əlaqə yoxlamaları. Run bütün qovluqları sıra ilə icra edir, unikal test məlumatları yaradır və sonda silir. Mövcud məlumatları dəyişmir. Java 25 tətbiqi və PostgreSQL işləməlidir.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/test-demo/api"
    }
  ],
  "item": [
    {
      "name": "Cache",
      "description": "Task21: entity/query cache, evict, stats reset, invalidation və Book qiyməti. Seed Course 1 lazımdır. Test müəllifi və kitabı sonda silinir. Collection və bulk @Modifying yoxlamaları ayrıca JUnit testindədir.",
      "item": [
        {
          "name": "01. Bütün cache-i təmizlə",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/cache"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "02. Statistikanı sıfırla",
          "request": {
            "method": "DELETE",
