        {
          "name": "19. Yeni müəllif",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/authors",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CacheCheck\",\n  \"surname\": \"{{$guid}}\",\n  \"country\": \"Azerbaijan\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"cacheAuthorId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "20. Query invalidation-dan sonra yeni nəticə",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/authors?country=Azerbaijan"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"New author appears\", () => { const data=pm.response.json(); pm.expect(data.length).to.eql(Number(pm.collectionVariables.get(\"cacheAuthorCount\"))+1); pm.expect(data.some(a=>a.id===Number(pm.collectionVariables.get(\"cacheAuthorId\")))).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "21. Test kitabı",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/books",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"CacheCheck-{{$guid}}\",\n  \"price\": 11.25,\n  \"pageCount\": 123\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"cacheBookId\", pm.response.json().id);",
                  "pm.collectionVariables.set(\"cacheBookTitle\", pm.response.json().title);"
                ]
              }
            }
          ]
        },
