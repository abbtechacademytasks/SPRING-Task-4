              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"First read: miss1 put1 hit0\", () => { const s=pm.response.json().regions.courses; pm.expect(s.missCount).to.eql(1); pm.expect(s.putCount).to.eql(1); pm.expect(s.hitCount).to.eql(0); });"
                ]
              }
            }
          ]
