              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                      "pm.test(\"Salary1200\",()=>pm.expect(pm.response.json().newSalary).to.eql(1200));"
                    ]
                  }
                }
              ]
            },
            {
