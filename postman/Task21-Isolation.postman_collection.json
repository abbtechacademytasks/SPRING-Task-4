            {
              "name": "05. Negative amount",
              "request": {
                "method": "POST",
                "header": [],
                "url": "{{baseUrl}}/isolation/employees/{{d2EmployeeId}}/raise?amount=-100&isolation=READ_COMMITTED&delayMs=0"
              },
              "event": [
                {
                  "listen": "test",
