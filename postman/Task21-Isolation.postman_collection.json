                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "07. Final salary unchanged after rejected requests",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/employees/{{d2EmployeeId}}"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                      "pm.test(\"Final salary1200\",()=>pm.expect(pm.response.json().salary).to.eql(1200));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "08. Delete test employee",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": "{{baseUrl}}/employees/{{d2EmployeeId}}"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 204\",()=>pm.response.to.have.status(204));"
                    ]
                  }
                }
              ]
            }
          ]
        },
